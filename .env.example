# CaseSignal environment configuration
#
# Copy to .env.local and fill in what you need.
#
# NOTHING HERE IS REQUIRED TO RUN THE APP. With an empty file CaseSignal starts
# in local mode: an embedded Postgres database, local private file storage, a
# local development session, and deterministic on-device analysis. Every value
# below upgrades one capability; the app tells you in Settings → Workspace which
# ones are configured.
#
# Never commit real credentials.

# ---------------------------------------------------------------- application
# Public origin. Used for share links, OAuth redirects and Stripe return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------------------- Clerk
# Authentication, sessions, profile management and organizations.
# Without these, CaseSignal uses a local cookie session for development.
# https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret for the user.updated / user.deleted webhook (Clerk → Webhooks).
CLERK_WEBHOOK_SECRET=

# ------------------------------------------------------------------ database
# Supabase Postgres. Without DATABASE_URL an embedded database is used and
# persisted to .casesignal/pgdata on this machine.
# Supabase → Project Settings → Database → Connection string (URI).
# Use the pooled connection for DATABASE_URL and the direct one for migrations.
DATABASE_URL=
DIRECT_URL=

# Optional: override where the embedded database stores its files.
# PGLITE_DATA_DIR=.casesignal/pgdata

# ------------------------------------------------------------------- storage
# Supabase Storage for uploaded source files. Create a PRIVATE bucket.
# Without these, files are written to a local directory outside the web root
# and served through an authorized route that re-checks case membership.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=case-sources

# Optional: override the local storage directory.
# LOCAL_STORAGE_DIR=.casesignal/storage

# ------------------------------------------------------------------ Anthropic
# Powers extraction, discrepancy analysis, source-backed answers, brief drafting
# and vision extraction from images. Without a key, CaseSignal runs deterministic
# local analysis over the same excerpts — every feature still works, and results
# are labelled "Local analysis".
# https://console.anthropic.com
ANTHROPIC_API_KEY=
# The runtime model. Read from the environment everywhere; never hardcoded.
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------- embeddings
# Optional semantic retrieval. Postgres full-text search is always used and is
# sufficient on its own; Voyage embeddings layer on top when configured.
# https://dash.voyageai.com
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --------------------------------------------------------------------- Stripe
# Subscriptions and the customer portal. Test mode keys are fine.
# Without these, billing is read-only and the upgrade buttons are disabled with
# a visible reason rather than failing.
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# The recurring price for the Pro plan ($24 / month).
STRIPE_PRO_PRICE_ID=

# ------------------------------------------------------------------------ ops
# HMAC salt for pseudonymous rate-limit and audit identifiers. Set any long
# random string in production; raw IP addresses are never stored.
RATE_LIMIT_SECRET=
# Shared secret for scheduled maintenance endpoints.
CRON_SECRET=

# ------------------------------------------------------------------- contact
# Optional. When unset, the site says the address is not configured rather than
# showing a placeholder.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_X=

# Set to 1 to expose the /showcase capture route in a production build.
# SHOWCASE_ENABLED=
